<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RecompRadar.Core\RecompRadar.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The runtime templates are source text for generated programs, not part of this library. -->
  <ItemGroup>
    <Compile Remove="Generation\Templates\**\*.cs" />
    <EmbeddedResource Include="Generation\Templates\*.cs" LogicalName="Templates/%(Filename)%(Extension)" />
    <!-- The shared semantics are compiled here and also copied verbatim into generated programs. -->
    <EmbeddedResource Include="Shared\IrSemantics.cs" LogicalName="Templates/IrSemantics.cs" />
    <EmbeddedResource Include="Shared\Ps2Runtime.cs" LogicalName="Templates/Ps2Runtime.cs" />
  </ItemGroup>

</Project>
