<Window x:Class="RecompRadar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RecompRadar.App.ViewModels"
        xmlns:views="clr-namespace:RecompRadar.App.Views"
        xmlns:beh="clr-namespace:RecompRadar.App.Behaviors"
        Title="RecompRadar – Console Binary Analysis"
        Width="1320" Height="840" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/RecompRadar;component/Assets/RecompRadar.png"
        beh:FileDrop.Command="{Binding DropFilesCommand}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BinaryAnalyzerViewModel}"><views:BinaryAnalyzerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchitectureViewModel}"><views:ArchitectureView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DependenciesViewModel}"><views:DependenciesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}"><views:ReportView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,24">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconRadar}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RecompRadar" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="Console binary analysis" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Navigation" Style="{StaticResource NavItemStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconShield}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Static analysis only" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Analyzed files are read, never executed. Nothing is decrypted." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Page area ===== -->
        <Grid Grid.Column="1" Margin="30,24,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding CurrentPage.Title}" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}"
                            TargetUpdated="PageHost_TargetUpdated" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ===== Notification banner ===== -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="30" MaxWidth="580"
                CornerRadius="14" BorderThickness="1" Padding="16,12"
                Background="{Binding Notifications.Kind, Converter={StaticResource NotificationKindToBrush}, ConverterParameter=soft}"
                BorderBrush="{Binding Notifications.Kind, Converter={StaticResource NotificationKindToBrush}}"
                Visibility="{Binding Notifications.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notifications.IsVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,12,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{Binding Notifications.Kind, Converter={StaticResource NotificationKindToIcon}}"
                              Stroke="{Binding Notifications.Kind, Converter={StaticResource NotificationKindToBrush}}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Notifications.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Notifications.Message}" Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Notifications.Details}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding Notifications.Details, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding Notifications.DismissCommand}" VerticalAlignment="Top" Margin="10,-4,-6,0" ToolTip="Dismiss">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Analysis progress overlay ===== -->
        <Grid Grid.ColumnSpan="2" Background="#B3080A0E" Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="480" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource SurfaceRaisedBrush}">
                <StackPanel>
                    <TextBlock Text="Analyzing…" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Session.Stage}" Style="{StaticResource Muted}" Margin="0,6,0,16" />
                    <ProgressBar Value="{Binding Session.Progress}" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding Session.Progress, Converter={StaticResource Percent}}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Button Content="Cancel" HorizontalAlignment="Right" Command="{Binding CancelAnalysisCommand}" />
                    </Grid>
                    <TextBlock Text="The file is only read and inspected. It is never started." Style="{StaticResource Caption}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
