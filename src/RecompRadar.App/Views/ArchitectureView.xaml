<UserControl x:Class="RecompRadar.App.Views.ArchitectureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasResult, Converter={StaticResource InvertedBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="No architecture to show yet" Style="{StaticResource H3}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="Analyze an ELF file in the Binary Analyzer (or open a saved project). The CPU architecture and the porting consequences appear here. Files that could not be parsed have no architecture to inspect." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,14,0">

                <Border Style="{StaticResource Card}" Padding="20,10" Margin="0,0,0,14">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SummaryRows}" ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,6"
                                   Text="“Verified” values were read from the file or follow directly from it. “Inferred” values are hints and may be wrong." />
                    </StackPanel>
                </Border>

                <!-- Target system hints -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Target system – hints, not proof" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding TargetSummary}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TargetDisclaimer}" Style="{StaticResource Caption}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,6,0,0" Padding="14,10" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceRaisedBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Margin="10,0,0,0" CornerRadius="9" Padding="8,1" BorderThickness="1" BorderBrush="{StaticResource WarningBrush}" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Strength}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="230" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Visibility="{Binding Note, Converter={StaticResource StringToVisibility}}" />
                                                            </StackPanel>
                                                            <ContentControl Grid.Column="2" Content="{Binding Evidence}" ContentTemplate="{StaticResource EvidenceBadge}" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Caveats}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"><Run Text="Note:  " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Facts read from the ELF header -->
                <Border Style="{StaticResource Card}" Padding="20,14,20,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Properties read from the file" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding FactRows}" ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="What matters for translation" Style="{StaticResource H3}" />
                        <ItemsControl ItemsSource="{Binding TechnicalNotes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,3" TextWrapping="Wrap"><Run Text="•  " Foreground="{StaticResource AccentBrush}" /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0">
                            <Run Text="Recompiler building blocks in RecompRadar:  " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="{Binding RecompilationSupport, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Entry point preview from the proof-of-concept decoder -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Entry point preview (proof of concept)" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Caption}" Margin="0,2,0,8" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding PreviewLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding PreviewNote, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="A decoder is only available for architectures that have a plugin. No preview is shown for other architectures; nothing is guessed." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
