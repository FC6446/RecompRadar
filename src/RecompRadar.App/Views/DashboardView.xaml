<UserControl x:Class="RecompRadar.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:RecompRadar.App.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">

            <!-- Drop zone -->
            <ContentControl Style="{StaticResource DropZoneControl}" beh:FileDrop.Command="{Binding DropFilesCommand}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoftBrush}" Margin="0,0,22,0">
                        <Viewbox Width="30" Height="30">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconUpload}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Drop an executable here to analyze it" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="ELF files (32-bit or 64-bit, little or big endian). The file is read and inspected – it is never run, unpacked or decrypted." />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open file…" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseCommand}" VerticalAlignment="Center" Margin="22,0,0,0" />
                </Grid>
            </ContentControl>

            <!-- Numbers -->
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Saved projects" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ProjectCount}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Last analysis" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LastAnalysisText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Last architecture" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LastArchitectureText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recent projects -->
                <Border Style="{StaticResource Card}" Margin="0,0,9,0" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Recent projects" Style="{StaticResource H3}" />
                            <Button Content="All projects" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding GoToProjectsCommand}"
                                    Visibility="{Binding HasProjects, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="Nothing here yet. Analyze a file and it is saved automatically, so you can reopen it later."
                                   Style="{StaticResource Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding HasProjects, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding RecentProjects}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,8"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Architecture, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding AnalyzedAtUtc, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Scope -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="What RecompRadar does – and does not do" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="RecompRadar is an analysis tool, not a universal console recompiler. It tells you what a native Windows port of a binary would require. It does not make console software run." />
                        <TextBlock Text="Analyzed" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding SupportedFormats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,3" TextWrapping="Wrap"><Run Text="✓  " Foreground="{StaticResource SuccessBrush}" /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Not supported" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding NotSupported}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,3" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"><Run Text="–  " Foreground="{StaticResource WarningBrush}" /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
