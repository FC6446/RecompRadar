<UserControl x:Class="RecompRadar.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0" MaxWidth="860" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Analysis" Style="{StaticResource H3}" />

                    <TextBlock Text="Largest file to analyze (MiB)" Margin="0,14,0,4" />
                    <TextBox Text="{Binding MaxFileSizeText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Files above this size are refused before they are read. This protects against disc images, archives and damaged files. Allowed: 1 to 16384." />

                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,18,0,0" IsChecked="{Binding AutoSaveProjects}" Content="Save every successful analysis as a project" />
                    <TextBlock Style="{StaticResource Caption}" Margin="56,4,0,0"
                               Text="Only results are stored in a local database. The analyzed file is not copied. Failed analyses are not saved." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Folders" Style="{StaticResource H3}" />

                    <TextBlock Text="Default folder for exported reports" Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" Tag="Ask every time" />
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseExportDirectoryCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="Extra knowledge-base folder" Margin="0,16,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ExtraKnowledgeDirectory, UpdateSourceTrigger=PropertyChanged}" Tag="Default: knowledge folder inside the RecompRadar data folder" />
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseKnowledgeDirectoryCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="JSON files in this folder extend the built-in list of known API, library and device names. Invalid files are skipped with a note." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H3}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" IsChecked="{Binding EnableAnimations}" Content="Animate page changes" />
                    <TextBlock Style="{StaticResource Caption}" Margin="56,4,0,0" Text="RecompRadar uses a dark theme." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                <Button Content="Restore defaults" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}" />

            <Border Style="{StaticResource Card}" Margin="0,6,0,14">
                <StackPanel>
                    <TextBlock Text="Where RecompRadar keeps its data" Style="{StaticResource H3}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Data folder" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Column="1" Text="{Binding Paths.Root}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Project database" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Paths.Database}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Grid.Row="2" Text="Log files" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Paths.Logs}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Grid.Row="3" Text="Version" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VersionText}" Margin="0,4" />
                        <TextBlock Grid.Row="4" Text="Runtime" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RuntimeText}" TextWrapping="Wrap" Margin="0,4" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Open knowledge folder" Command="{Binding OpenKnowledgeFolderCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                               Text="Logs are structured JSON lines (one event per line). They contain file names and hashes but never file contents." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
