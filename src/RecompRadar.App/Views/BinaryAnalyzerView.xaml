<UserControl x:Class="RecompRadar.App.Views.BinaryAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:RecompRadar.App.Behaviors">
    <Grid>
        <!-- ===== Nothing analyzed yet ===== -->
        <ContentControl Style="{StaticResource DropZoneControl}" beh:FileDrop.Command="{Binding DropFilesCommand}"
                        VerticalAlignment="Top" Height="320"
                        Visibility="{Binding HasResult, Converter={StaticResource InvertedBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <Viewbox Width="34" Height="34">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconUpload}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="Drop an ELF file here" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="460" Margin="0,6,0,18"
                           Text="Headers, segments, sections, symbols, imports and memory regions are read without running the file." />
                <Button Content="Choose a file…" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </ContentControl>

        <!-- ===== Result ===== -->
        <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl Style="{StaticResource DropZoneControl}" Padding="0" beh:FileDrop.Command="{Binding DropFilesCommand}" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Background="Transparent" BorderThickness="0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FilePath}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Size" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding SizeText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Format" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding FormatText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Architecture" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding ArchitectureText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Entry point" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding EntryText}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}">
                                <Run Text="SHA-256  " /><Run Text="{Binding Sha256, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                            <Button Content="Analyze another file…" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseCommand}" />
                            <TextBlock Text="or drop a file here" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ContentControl>

            <!-- Problem banner -->
            <Border Grid.Row="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" BorderThickness="1"
                    Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                    Visibility="{Binding IsParsed, Converter={StaticResource InvertedBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding ProblemTitle}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding ProblemText}" Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Details when the file was parsed -->
            <TabControl Grid.Row="2" Visibility="{Binding IsParsed, Converter={StaticResource BoolToVisibility}}">
                <TabItem Header="Header">
                    <Border Style="{StaticResource Card}" Padding="18,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HeaderRows}" ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem Header="Segments">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Segments}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="170" />
                                <DataGridTextColumn Header="File offset" Binding="{Binding Offset, StringFormat='0x{0:X}'}" Width="120" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="Virtual address" Binding="{Binding VirtualAddress, StringFormat='0x{0:X8}'}" Width="140" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="File size" Binding="{Binding FileSize, StringFormat='{}{0:N0}'}" Width="110" />
                                <DataGridTextColumn Header="Memory size" Binding="{Binding MemorySize, StringFormat='{}{0:N0}'}" Width="120" />
                                <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="70" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="Alignment" Binding="{Binding Alignment, StringFormat='0x{0:X}'}" Width="*" ElementStyle="{StaticResource MonoCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Sections">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="This file has no section headers (they are optional and often removed). Segments still describe what is loaded."
                                       Margin="20" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sections.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding Sections}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address, StringFormat='0x{0:X8}'}" Width="130" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="File offset" Binding="{Binding Offset, StringFormat='0x{0:X}'}" Width="110" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='{}{0:N0}'}" Width="110" />
                                    <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="70" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Symbols">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,14,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SymbolFilter, UpdateSourceTrigger=PropertyChanged}" Tag="Filter symbols by name…" />
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Content="Imports only" IsChecked="{Binding ImportsOnly}" Margin="16,0,0,0" />
                            </Grid>
                            <Border Grid.Row="1" Margin="16,0,16,8" CornerRadius="9" Padding="12,8" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    Visibility="{Binding NoSymbols, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SymbolSummary}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding SymbolSummary}" Style="{StaticResource Caption}" Margin="18,0,16,8"
                                       Visibility="{Binding NoSymbols, Converter={StaticResource InvertedBoolToVisibility}}" />
                            <DataGrid Grid.Row="2" ItemsSource="{Binding SymbolsView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat='0x{0:X8}'}" Width="120" ElementStyle="{StaticResource MonoCell}" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='{}{0:N0}'}" Width="80" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                                    <DataGridTextColumn Header="Bind" Binding="{Binding Binding}" Width="80" />
                                    <DataGridTextColumn Header="Visibility" Binding="{Binding Visibility}" Width="90" />
                                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="70" />
                                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="70" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Memory regions">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Regions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Region" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                                <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat='0x{0:X8}'}" Width="130" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="End" Binding="{Binding End, StringFormat='0x{0:X8}'}" Width="130" ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat='{}{0:N0}'}" Width="120" />
                                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="*" ElementStyle="{StaticResource MonoCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="Diagnostics">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="No warnings or notes. The structure of the file is consistent." Margin="20" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Diagnostics.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="16,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceRaisedBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                        <TextBlock Text="{Binding Code}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="10,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                                               Visibility="{Binding Explanation, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- For files that could not be parsed, show the diagnostics directly -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsParsed, Converter={StaticResource InvertedBoolToVisibility}}" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="16,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceRaisedBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Code}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="10,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                               Visibility="{Binding Explanation, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
