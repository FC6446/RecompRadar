<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: one dark theme, defined once. Everything else references these keys. -->
    <Color x:Key="BgColor">#0E1015</Color>
    <Color x:Key="SidebarColor">#12151B</Color>
    <Color x:Key="SurfaceColor">#171A22</Color>
    <Color x:Key="SurfaceRaisedColor">#1F2430</Color>
    <Color x:Key="SurfaceHoverColor">#272D3C</Color>
    <Color x:Key="BorderColor">#2A303D</Color>
    <Color x:Key="TextColor">#E8EAF0</Color>
    <Color x:Key="TextMutedColor">#9BA4B6</Color>
    <Color x:Key="TextFaintColor">#6B7487</Color>
    <Color x:Key="AccentColor">#5B8CFF</Color>
    <Color x:Key="AccentHoverColor">#7DA3FF</Color>
    <Color x:Key="AccentPressedColor">#4673E0</Color>
    <Color x:Key="AccentSoftColor">#1B2850</Color>
    <Color x:Key="SuccessColor">#3FB950</Color>
    <Color x:Key="SuccessSoftColor">#14301F</Color>
    <Color x:Key="WarningColor">#E3B341</Color>
    <Color x:Key="WarningSoftColor">#352B10</Color>
    <Color x:Key="DangerColor">#F85149</Color>
    <Color x:Key="DangerSoftColor">#3A1819</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
