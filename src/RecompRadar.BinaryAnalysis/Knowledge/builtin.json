{
  "schemaVersion": 1,
  "name": "RecompRadar built-in knowledge base",
  "version": "2026.10.1",
  "rules": [
    { "id": "lib.libc", "kind": "library", "match": "prefix", "patterns": ["libc.so"], "category": "C runtime", "apiFamily": "C standard library", "platforms": [], "description": "Dynamic C library (glibc or a compatible implementation)." },
    { "id": "lib.libm", "kind": "library", "match": "prefix", "patterns": ["libm.so"], "category": "Math", "apiFamily": "C math library", "platforms": [], "description": "Math functions (sin, cos, sqrt, ...)." },
    { "id": "lib.pthread", "kind": "library", "match": "prefix", "patterns": ["libpthread.so"], "category": "Threading", "apiFamily": "POSIX threads", "platforms": [], "description": "POSIX thread library." },
    { "id": "lib.dl", "kind": "library", "match": "prefix", "patterns": ["libdl.so"], "category": "Dynamic loading", "apiFamily": "dlopen/dlsym", "platforms": [], "description": "Runtime loading of shared libraries." },
    { "id": "lib.rt", "kind": "library", "match": "prefix", "patterns": ["librt.so"], "category": "POSIX / OS", "apiFamily": "POSIX realtime extensions", "platforms": [], "description": "Timers, shared memory and message queues." },
    { "id": "lib.stdcxx", "kind": "library", "match": "prefix", "patterns": ["libstdc++.so"], "category": "C++ runtime", "apiFamily": "GNU C++ standard library", "platforms": [], "description": "The program is written in C++ and links the GNU C++ runtime." },
    { "id": "lib.libcxx", "kind": "library", "match": "prefix", "patterns": ["libc++.so", "libc++abi.so"], "category": "C++ runtime", "apiFamily": "LLVM C++ standard library", "platforms": [], "description": "The program is written in C++ and links the LLVM C++ runtime." },
    { "id": "lib.gcc_s", "kind": "library", "match": "prefix", "patterns": ["libgcc_s.so"], "category": "C runtime", "apiFamily": "GCC runtime support", "platforms": [], "description": "Compiler support routines (exceptions, 64-bit arithmetic on small CPUs)." },
    { "id": "lib.ld", "kind": "library", "match": "prefix", "patterns": ["ld-linux", "ld.so"], "category": "POSIX / OS", "apiFamily": "Linux dynamic loader", "platforms": ["linux"], "description": "Program interpreter of dynamically linked Linux executables." },
    { "id": "lib.sdl", "kind": "library", "match": "prefix", "patterns": ["libSDL2", "libSDL-1"], "category": "Multimedia", "apiFamily": "SDL (Simple DirectMedia Layer)", "platforms": [], "description": "Cross-platform window, input, audio and graphics library. SDL exists for Windows." },
    { "id": "lib.opengl", "kind": "library", "match": "prefix", "patterns": ["libGL.so", "libGLU.so"], "category": "Graphics", "apiFamily": "OpenGL", "platforms": [], "description": "OpenGL graphics API." },
    { "id": "lib.gles", "kind": "library", "match": "prefix", "patterns": ["libEGL.so", "libGLESv2.so", "libGLESv1_CM.so"], "category": "Graphics", "apiFamily": "EGL / OpenGL ES", "platforms": [], "description": "OpenGL ES graphics API and context creation." },
    { "id": "lib.vulkan", "kind": "library", "match": "prefix", "patterns": ["libvulkan.so"], "category": "Graphics", "apiFamily": "Vulkan", "platforms": [], "description": "Vulkan graphics API." },
    { "id": "lib.x11", "kind": "library", "match": "prefix", "patterns": ["libX11.so", "libxcb.so", "libwayland-client.so"], "category": "Graphics", "apiFamily": "Linux windowing system (X11/Wayland)", "platforms": ["linux"], "description": "Window system client library; a Windows port needs a different windowing backend." },
    { "id": "lib.alsa", "kind": "library", "match": "prefix", "patterns": ["libasound.so"], "category": "Audio", "apiFamily": "ALSA (Linux audio)", "platforms": ["linux"], "description": "Linux sound API." },
    { "id": "lib.pulse", "kind": "library", "match": "prefix", "patterns": ["libpulse"], "category": "Audio", "apiFamily": "PulseAudio", "platforms": ["linux"], "description": "Linux sound server client library." },
    { "id": "lib.openal", "kind": "library", "match": "prefix", "patterns": ["libopenal"], "category": "Audio", "apiFamily": "OpenAL", "platforms": [], "description": "Cross-platform 3D audio API." },
    { "id": "lib.zlib", "kind": "library", "match": "prefix", "patterns": ["libz.so"], "category": "Compression", "apiFamily": "zlib", "platforms": [], "description": "Deflate compression library." },
    { "id": "lib.libpng", "kind": "library", "match": "prefix", "patterns": ["libpng"], "category": "Multimedia", "apiFamily": "libpng", "platforms": [], "description": "PNG image decoding." },
    { "id": "lib.sce", "kind": "library", "match": "prefix", "patterns": ["libSce"], "category": "Console SDK", "apiFamily": "Sony SCE system modules (libSce* naming)", "platforms": ["ps4"], "description": "Library names that start with 'libSce' are used by Sony's PlayStation 4 (and PS Vita) system modules." },

    { "id": "sym.c.stdio", "kind": "symbol", "match": "exact", "patterns": ["printf", "fprintf", "sprintf", "snprintf", "vprintf", "vfprintf", "vsnprintf", "puts", "putchar", "fputs", "fputc", "getchar", "fgets", "scanf", "sscanf", "perror"], "category": "C runtime", "apiFamily": "C standard I/O", "platforms": [], "description": "Formatted console and string I/O." },
    { "id": "sym.c.file", "kind": "symbol", "match": "exact", "patterns": ["fopen", "fclose", "fread", "fwrite", "fseek", "ftell", "fflush", "remove", "rename", "tmpfile"], "category": "Filesystem", "apiFamily": "C standard file I/O", "platforms": [], "description": "Buffered file access." },
    { "id": "sym.c.stdlib", "kind": "symbol", "match": "exact", "patterns": ["malloc", "calloc", "realloc", "free", "memcpy", "memmove", "memset", "memcmp", "memchr", "strlen", "strcpy", "strncpy", "strcmp", "strncmp", "strcat", "strncat", "strchr", "strrchr", "strstr", "strtol", "strtoul", "strtod", "atoi", "atof", "qsort", "bsearch", "abs", "rand", "srand", "exit", "abort", "atexit", "getenv", "setjmp", "longjmp", "time", "clock"], "category": "C runtime", "apiFamily": "C standard library", "platforms": [], "description": "Memory, string, conversion and process functions of the C library." },
    { "id": "sym.glibc.startup", "kind": "symbol", "match": "exact", "patterns": ["__libc_start_main", "__cxa_atexit", "__cxa_finalize", "__stack_chk_fail", "__gmon_start__", "_ITM_deregisterTMCloneTable", "_ITM_registerTMCloneTable", "__assert_fail", "__errno_location"], "category": "C runtime", "apiFamily": "glibc startup and support symbols", "platforms": ["linux"], "description": "Symbols that are typical of programs linked against glibc on Linux." },
    { "id": "sym.posix.io", "kind": "symbol", "match": "exact", "patterns": ["open", "read", "write", "close", "lseek", "stat", "fstat", "unlink", "mkdir", "opendir", "readdir", "closedir", "access", "dup", "dup2", "pipe", "fcntl"], "category": "POSIX / OS", "apiFamily": "POSIX file I/O", "platforms": [], "description": "Unix-style file descriptors. Windows offers a partial CRT equivalent, not a full POSIX layer." },
    { "id": "sym.posix.mem", "kind": "symbol", "match": "exact", "patterns": ["mmap", "munmap", "mprotect", "madvise", "brk", "sbrk"], "category": "POSIX / OS", "apiFamily": "Virtual memory management", "platforms": [], "description": "Direct control over the address space." },
    { "id": "sym.posix.proc", "kind": "symbol", "match": "exact", "patterns": ["fork", "execve", "execv", "execvp", "waitpid", "kill", "signal", "sigaction", "getpid", "_exit", "syscall"], "category": "POSIX / OS", "apiFamily": "Process and signal control", "platforms": [], "description": "Unix process model; has no direct Windows equivalent (for example fork)." },
    { "id": "sym.posix.time", "kind": "symbol", "match": "exact", "patterns": ["gettimeofday", "clock_gettime", "nanosleep", "usleep", "sleep", "localtime", "gmtime", "strftime"], "category": "POSIX / OS", "apiFamily": "Time and sleeping", "platforms": [], "description": "Clocks, timers and sleeping." },
    { "id": "sym.posix.net", "kind": "symbol", "match": "exact", "patterns": ["socket", "bind", "listen", "accept", "connect", "send", "recv", "sendto", "recvfrom", "select", "poll", "getaddrinfo", "gethostbyname", "setsockopt"], "category": "Network", "apiFamily": "BSD sockets", "platforms": [], "description": "Network access through sockets. Windows has Winsock with similar semantics." },
    { "id": "sym.posix.dl", "kind": "symbol", "match": "exact", "patterns": ["dlopen", "dlsym", "dlclose", "dlerror"], "category": "Dynamic loading", "apiFamily": "dlopen/dlsym", "platforms": [], "description": "Runtime loading of libraries; the loaded names are only known at run time." },
    { "id": "sym.posix.threads", "kind": "symbol", "match": "exact", "patterns": ["pthread_create", "pthread_join", "pthread_detach", "pthread_self", "pthread_exit", "pthread_mutex_init", "pthread_mutex_lock", "pthread_mutex_unlock", "pthread_mutex_destroy", "pthread_cond_init", "pthread_cond_wait", "pthread_cond_signal", "pthread_cond_broadcast", "sem_init", "sem_wait", "sem_post"], "category": "Threading", "apiFamily": "POSIX threads", "platforms": [], "description": "Threads, mutexes and semaphores." },
    { "id": "sym.hw.ioctl", "kind": "symbol", "match": "exact", "patterns": ["ioctl"], "category": "Hardware access", "apiFamily": "Device control (ioctl)", "platforms": [], "hardware": true, "description": "ioctl talks to device drivers. Which devices are used cannot be told from the import alone." },
    { "id": "sym.hw.ioport", "kind": "symbol", "match": "exact", "patterns": ["ioperm", "iopl"], "category": "Hardware access", "apiFamily": "x86 I/O port access", "platforms": [], "hardware": true, "description": "Requests direct access to x86 hardware I/O ports." },
    { "id": "sym.sdl", "kind": "symbol", "match": "prefix", "patterns": ["SDL_"], "category": "Multimedia", "apiFamily": "SDL (Simple DirectMedia Layer)", "platforms": [], "description": "SDL window, input, audio and graphics functions. SDL exists for Windows." },
    { "id": "sym.opengl", "kind": "symbol", "match": "exact", "patterns": ["glClear", "glClearColor", "glDrawArrays", "glDrawElements", "glBindTexture", "glGenTextures", "glTexImage2D", "glViewport", "glEnable", "glDisable", "glBegin", "glEnd", "glVertex3f", "glMatrixMode", "glLoadIdentity", "glFlush", "glFinish", "glGetString", "glGetError", "glCreateShader", "glCompileShader", "glUseProgram", "glBindBuffer", "glBufferData", "glGenBuffers"], "category": "Graphics", "apiFamily": "OpenGL", "platforms": [], "description": "OpenGL calls. Windows supports OpenGL; the required version and extensions are not determined." },
    { "id": "sym.glx_egl", "kind": "symbol", "match": "exact", "patterns": ["glXSwapBuffers", "glXCreateContext", "glXMakeCurrent", "glXChooseVisual", "eglGetDisplay", "eglInitialize", "eglCreateContext", "eglSwapBuffers", "eglMakeCurrent"], "category": "Graphics", "apiFamily": "GLX / EGL context creation", "platforms": [], "description": "OpenGL context creation through the Linux window system or EGL." },
    { "id": "sym.vulkan", "kind": "symbol", "match": "exact", "patterns": ["vkCreateInstance", "vkEnumeratePhysicalDevices", "vkCreateDevice", "vkQueueSubmit", "vkCmdDraw", "vkCmdDrawIndexed", "vkCreateSwapchainKHR", "vkGetInstanceProcAddr"], "category": "Graphics", "apiFamily": "Vulkan", "platforms": [], "description": "Vulkan calls." },
    { "id": "sym.openal", "kind": "symbol", "match": "exact", "patterns": ["alcOpenDevice", "alcCreateContext", "alGenBuffers", "alGenSources", "alSourcePlay", "alBufferData"], "category": "Audio", "apiFamily": "OpenAL", "platforms": [], "description": "OpenAL audio calls." },
    { "id": "sym.alsa", "kind": "symbol", "match": "prefix", "patterns": ["snd_pcm_"], "category": "Audio", "apiFamily": "ALSA (Linux audio)", "platforms": ["linux"], "description": "ALSA PCM audio functions." },

    { "id": "sym.psp.gu", "kind": "symbol", "match": "prefix", "patterns": ["sceGu"], "category": "Graphics", "apiFamily": "PSP graphics utility library (sceGu*)", "platforms": ["psp"], "description": "Graphics calls of the PSP SDK's GU library." },
    { "id": "sym.psp.only", "kind": "symbol", "match": "exact", "patterns": ["sceGeListEnQueue", "sceGeListSync", "sceGeListUpdateStallAddr", "sceKernelExitGame", "sceKernelDcacheWritebackAll", "sceKernelDcacheWritebackInvalidateAll", "sceDisplaySetMode", "sceAudioChReserve", "sceAudioOutputPannedBlocking"], "category": "Console SDK", "apiFamily": "PlayStation Portable system calls", "platforms": ["psp"], "description": "Function names from the PSP SDK." },
    { "id": "sym.sce.shared", "kind": "symbol", "match": "exact", "patterns": ["sceCtrlReadBufferPositive", "sceCtrlSetSamplingCycle", "sceCtrlSetSamplingMode", "sceDisplayWaitVblankStart", "sceIoOpen", "sceIoRead", "sceIoWrite", "sceIoClose", "sceKernelCreateThread", "sceKernelStartThread", "sceKernelDelayThread"], "category": "Console SDK", "apiFamily": "Sony SCE kernel/IO/input names (PSP, PS Vita)", "platforms": ["psp", "vita"], "description": "Function names shared by the PSP and PS Vita SDKs; they do not identify one console alone." },
    { "id": "sym.sce.kernel", "kind": "symbol", "match": "prefix", "patterns": ["sceKernel"], "category": "Console SDK", "apiFamily": "Sony SCE kernel API naming", "platforms": ["psp", "vita", "ps4"], "description": "'sceKernel*' names exist on several Sony platforms; this alone does not identify the console." },
    { "id": "sym.ps2.sdk", "kind": "symbol", "match": "prefix", "patterns": ["sceSif", "sceGs", "sceDma", "sceVu0", "sceMc", "sceCd"], "category": "Console SDK", "apiFamily": "PlayStation 2 SDK libraries (libsif, libgraph, libdma, libvu0, libmc, libcdvd)", "platforms": ["ps2"], "description": "Function name prefixes of the PlayStation 2 SDK." },
    { "id": "sym.ps2.homebrew", "kind": "symbol", "match": "exact", "patterns": ["SifInitRpc", "SifExitRpc", "SifLoadModule", "SifIopReset", "SifIopSync", "dma_channel_initialize", "dma_channel_send_normal", "graph_initialize", "graph_set_mode", "padInit", "padPortOpen", "padRead"], "category": "Console SDK", "apiFamily": "PlayStation 2 homebrew SDK (ps2sdk)", "platforms": ["ps2"], "description": "Function names of the open-source ps2sdk." },
    { "id": "sym.pad", "kind": "symbol", "match": "prefix", "patterns": ["scePad"], "category": "Input", "apiFamily": "SCE controller library (PS2 libpad, PS4 libScePad)", "platforms": ["ps2", "ps4"], "description": "Controller functions used on more than one Sony platform." },
    { "id": "sym.ps3.cell", "kind": "symbol", "match": "prefix", "patterns": ["cellGcm", "cellSysutil", "cellSysmodule", "cellPad", "cellSpurs", "cellFs", "cellAudio"], "category": "Console SDK", "apiFamily": "PlayStation 3 Cell SDK libraries", "platforms": ["ps3"], "description": "Function name prefixes of the PlayStation 3 Cell SDK." },
    { "id": "sym.ps3.lv2", "kind": "symbol", "match": "prefix", "patterns": ["sys_ppu_thread_", "sys_spu_", "sys_lwmutex_", "sys_lwcond_", "sys_prx_", "sys_process_", "sys_timer_", "sys_memory_"], "category": "Console SDK", "apiFamily": "PlayStation 3 LV2 system calls", "platforms": ["ps3"], "description": "System call wrappers of the PlayStation 3 operating system." },
    { "id": "sym.ps3.psl1ght", "kind": "symbol", "match": "exact", "patterns": ["ioPadInit", "ioPadGetData", "gcmInitBody", "sysThreadCreate"], "category": "Console SDK", "apiFamily": "PlayStation 3 homebrew SDK (PSL1GHT)", "platforms": ["ps3"], "description": "Function names of the open-source PSL1GHT SDK." },
    { "id": "sym.ps4.only", "kind": "symbol", "match": "prefix", "patterns": ["sceGnm", "sceVideoOut", "sceUserService"], "category": "Console SDK", "apiFamily": "PlayStation 4 system libraries", "platforms": ["ps4"], "description": "Function name prefixes of PlayStation 4 graphics (GNM), video output and user services." },
    { "id": "sym.ps4.shared", "kind": "symbol", "match": "prefix", "patterns": ["sceAudioOut", "sceSysmodule"], "category": "Console SDK", "apiFamily": "Sony SCE audio output and module loading", "platforms": ["ps4", "vita"], "description": "Function name prefixes used by the PlayStation 4 and PS Vita." },
    { "id": "sym.ps4.kernel", "kind": "symbol", "match": "exact", "patterns": ["sceKernelAllocateDirectMemory", "sceKernelMapDirectMemory"], "category": "Console SDK", "apiFamily": "PlayStation 4 kernel memory API", "platforms": ["ps4"], "description": "Direct memory management calls of the PlayStation 4." },
    { "id": "sym.ogc", "kind": "symbol", "match": "prefix", "patterns": ["GX_", "VIDEO_", "PAD_", "LWP_", "CARD_", "AUDIO_"], "category": "Console SDK", "apiFamily": "libogc (GameCube/Wii homebrew library)", "platforms": ["gamecube", "wii"], "description": "Function name prefixes of the open-source libogc library." },
    { "id": "sym.ogc.wii", "kind": "symbol", "match": "prefix", "patterns": ["WPAD_", "IOS_", "ASND_"], "category": "Console SDK", "apiFamily": "libogc Wii-only functions", "platforms": ["wii"], "description": "libogc functions that only exist for the Wii." },
    { "id": "sym.dolphinsdk", "kind": "symbol", "match": "exact", "patterns": ["GXInit", "GXSetViewport", "VIInit", "VIConfigure", "VISetNextFrameBuffer", "VIWaitForRetrace", "PADInit", "PADRead", "OSInit", "OSReport", "DVDInit"], "category": "Console SDK", "apiFamily": "Nintendo GameCube/Wii SDK function names", "platforms": ["gamecube", "wii"], "description": "Function names used by Nintendo's GameCube/Wii SDK." },
    { "id": "sym.dolphinsdk.wii", "kind": "symbol", "match": "exact", "patterns": ["WPADInit", "KPADInit"], "category": "Console SDK", "apiFamily": "Nintendo Wii SDK function names", "platforms": ["wii"], "description": "Wii-only controller initialisation functions." },

    { "id": "str.hw.devmem", "kind": "string", "match": "exact", "patterns": ["/dev/mem", "/dev/kmem", "/dev/port"], "category": "Hardware access", "apiFamily": "Direct memory / port device", "platforms": ["linux"], "hardware": true, "description": "References a device node that gives raw access to physical memory or I/O ports." },
    { "id": "str.hw.devnode", "kind": "string", "match": "prefix", "patterns": ["/dev/fb", "/dev/input/", "/dev/dri/", "/dev/snd/", "/dev/dsp", "/dev/uinput", "/dev/video"], "category": "Hardware access", "apiFamily": "Linux device node", "platforms": ["linux"], "hardware": true, "description": "References a Linux device node for framebuffer, input, graphics, sound or video hardware." },
    { "id": "str.ps2.dev", "kind": "string", "match": "prefix", "patterns": ["cdrom0:", "mc0:", "mc1:", "mass:", "rom0:", "rom1:"], "category": "Console SDK", "apiFamily": "PlayStation 2 device names", "platforms": ["ps2"], "description": "Device prefixes used in PlayStation 2 file paths." },
    { "id": "str.ps2psp.host", "kind": "string", "match": "prefix", "patterns": ["host0:"], "category": "Console SDK", "apiFamily": "Development host filesystem", "platforms": ["ps2", "psp"], "description": "Host filesystem prefix used in PlayStation 2 and PSP development setups." },
    { "id": "str.psp.dev", "kind": "string", "match": "prefix", "patterns": ["ms0:", "umd0:", "disc0:", "flash0:", "flash1:"], "category": "Console SDK", "apiFamily": "PSP device names", "platforms": ["psp"], "description": "Device prefixes used in PSP file paths." },
    { "id": "str.ps3.paths", "kind": "string", "match": "prefix", "patterns": ["/dev_hdd0", "/dev_bdvd", "/app_home", "/dev_flash", "/dev_usb"], "category": "Console SDK", "apiFamily": "PlayStation 3 mount points", "platforms": ["ps3"], "description": "Mount points used in PlayStation 3 file paths." },
    { "id": "str.ps4.paths", "kind": "string", "match": "prefix", "patterns": ["/app0/"], "category": "Console SDK", "apiFamily": "PlayStation 4 mount points", "platforms": ["ps4"], "description": "Application mount point used in PlayStation 4 file paths." },
    { "id": "str.wii.ios", "kind": "string", "match": "exact", "patterns": ["/dev/di", "/dev/es", "/dev/fs", "/dev/stm/immediate"], "category": "Console SDK", "apiFamily": "Wii IOS device names", "platforms": ["wii"], "description": "Device names of the Wii's IOS co-processor operating system." }
  ]
}
